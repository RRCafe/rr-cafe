{
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/delivery/(.*)",
      "destination": "/delivery/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "installCommand": "npm install"
}